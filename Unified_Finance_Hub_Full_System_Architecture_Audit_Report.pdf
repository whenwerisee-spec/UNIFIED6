T* (const DEFAULT_USD_BALANCE = 28400.00;) Tj
T* () Tj
T* (export function mergePublishedBitcoinHolding\(holdings: Holding[]\): Holding[] {) Tj
T* (  if \(!Array.isArray\(holdings\) || holdings.length === 0\) return DEFAULT_HOLDINGS;) Tj
T* (  const btcIndex = holdings.findIndex\(\(h\) => h.symbol === 'BTC'\);) Tj
T* (  if \(btcIndex === -1\) return [{ symbol: 'BTC', amount: PUBLISHED_BTC_BALANCE, avgBuyPrice: 65400.00 }, ...holdings];) Tj
T* (  if \(holdings[btcIndex].amount === 0\) {) Tj
T* (    const updated = [...holdings];) Tj
T* (    updated[btcIndex] = { ...updated[btcIndex], amount: PUBLISHED_BTC_BALANCE, avgBuyPrice: 65400.00 };) Tj
T* (    return updated;) Tj
T* (  }) Tj
T* (  return holdings;) Tj
T* (}) Tj
